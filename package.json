    "@strapi/plugin-users-permissions": "^5.12.7",
    "@strapi/strapi": "^5.12.7",
    "better-sqlite3": "11.3.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
