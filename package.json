{
  "name": "strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "main": "index.js",
  "scripts": {
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=production strapi build",
    "strapi": "strapi",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "build": {
      "transpileDependencies": [
        "@strapi/admin",
        "@strapi/design-system",
        "@strapi/helper-plugin",
        "@strapi/icons",
        "@strapi/utils",
        "@strapi/strapi"
      ]
    }
  },
  "swc": {
    "jiter": false,
    "jsc": {
      "target": "es2022",
      "parser": {
        "syntax": "typescript",
        "tsx": true,
        "decorators": true
      },
      "transform": {
        "legacyDecorator": true,
        "decoratorMetadata": true
      }
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ]
  },
